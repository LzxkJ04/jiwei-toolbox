{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "极维工具箱",
  "version": "1.0.0",
  "identifier": "com.jiwei.toolbox",
  "mainBinaryName": "jiwei-toolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "极维工具箱",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
